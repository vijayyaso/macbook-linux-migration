[Unit]
Description=Three-finger drag daemon (touchpad proxy, Wayland + Xorg)
# Start with the graphical session, not at basic login: the daemon auto-detects
# Wayland by the session socket, and starting too early made it fall back to
# passive mode (no touchpad grab -> GNOME's native 3-finger swipe fired on top
# of the drag).
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
Environment=PYTHONUNBUFFERED=1
Nice=-11
ExecStart=/usr/bin/python3 %h/Documents/three-finger-drag/three-finger-drag.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
