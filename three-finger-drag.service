[Unit]
Description=Three-finger drag daemon (macOS-style, Wayland + Xorg)
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
Environment=PYTHONUNBUFFERED=1
Nice=-11
ExecStart=/usr/bin/python3 %h/Documents/three-finger-drag/three-finger-drag.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
